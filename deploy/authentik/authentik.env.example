POSTGRES_DB=authentik
POSTGRES_USER=authentik
POSTGRES_PASSWORD=GENERATE_A_RANDOM_DATABASE_PASSWORD

AUTHENTIK_POSTGRESQL__HOST=postgresql
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=GENERATE_A_RANDOM_DATABASE_PASSWORD
AUTHENTIK_POSTGRESQL__SSLMODE=disable
AUTHENTIK_SECRET_KEY=GENERATE_A_RANDOM_AUTHENTIK_SECRET_KEY
AUTHENTIK_LOG_LEVEL=warning
AUTHENTIK_DISABLE_UPDATE_CHECK=true
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_OUTPOSTS__DISCOVER=false
AUTHENTIK_AVATARS=none

ICTHUB_OIDC_CLIENT_ID=GENERATE_A_RANDOM_OIDC_CLIENT_ID
ICTHUB_OIDC_CLIENT_SECRET=GENERATE_A_RANDOM_OIDC_CLIENT_SECRET
ICTHUB_CLOUDFLARE_REDIRECT_URI=https://CHANGE-ME.cloudflareaccess.com/cdn-cgi/access/callback

# SMTP is intentionally incomplete until a provider and sender domain are ready.
AUTHENTIK_EMAIL__HOST=
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__TIMEOUT=10
AUTHENTIK_EMAIL__FROM=ICThub <no-reply@icthub.top>
